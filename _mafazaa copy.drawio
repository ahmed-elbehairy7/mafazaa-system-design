                <mxCell id="_BMWQzA5p4reEyas-aQj-8" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b&gt;High level design (components)&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" parent="_BMWQzA5p4reEyas-aQj-1" vertex="1">
